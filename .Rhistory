set.seed(123)
n_total <- 150
# ---- Proportional allocation across districts ----
district_sizes <- ea_final %>%
st_drop_geometry() %>%
count(DISTRICT_NAME, name = "n_eas")
district_sizes <- district_sizes %>%
mutate(
proportion = n_eas / sum(n_eas),
n_sample_raw = proportion * n_total,
n_sample = round(n_sample_raw)
)
# Join allocation onto the EA data
ea_joined <- ea_final %>%
left_join(district_sizes %>% select(DISTRICT_NAME, n_sample), by = "DISTRICT_NAME")
ea_joined <- ea_joined %>%
filter(!is.na(DISTRICT_NAME))
# Split into a list of sf objects, one per district
ea_split <- split(ea_joined, ea_joined$DISTRICT_NAME)
# Sample within each district explicitly, using each district's own n_sample value
ea_sample_list <- map(ea_split, function(df) {
n_this_district <- unique(df$n_sample)
if (length(n_this_district) != 1) {
stop("District has inconsistent n_sample values - check the join")
}
if (n_this_district == 0) return(df[0, ])  # empty sf with 0 rows, keeps structure
slice_sample(df, n = n_this_district)
})
library(purrr)
set.seed(123)
n_total <- 150
# ---- Proportional allocation across districts ----
district_sizes <- ea_final %>%
st_drop_geometry() %>%
count(DISTRICT_NAME, name = "n_eas")
district_sizes <- district_sizes %>%
mutate(
proportion = n_eas / sum(n_eas),
n_sample_raw = proportion * n_total,
n_sample = round(n_sample_raw)
)
# Join allocation onto the EA data
ea_joined <- ea_final %>%
left_join(district_sizes %>% select(DISTRICT_NAME, n_sample), by = "DISTRICT_NAME")
ea_joined <- ea_joined %>%
filter(!is.na(DISTRICT_NAME))
# Split into a list of sf objects, one per district
ea_split <- split(ea_joined, ea_joined$DISTRICT_NAME)
# Sample within each district explicitly, using each district's own n_sample value
ea_sample_list <- map(ea_split, function(df) {
n_this_district <- unique(df$n_sample)
if (length(n_this_district) != 1) {
stop("District has inconsistent n_sample values - check the join")
}
if (n_this_district == 0) return(df[0, ])  # empty sf with 0 rows, keeps structure
slice_sample(df, n = n_this_district)
})
# Recombine into a single sf object
ea_sample <- bind_rows(ea_sample_list)
class(ea_sample)          # confirm this is still "sf"
nrow(ea_sample)           # should be 150 (or 150 minus whatever the NA-district exclusion cost you)
ggplot() +
geom_sf(data = mun_sf, fill = "grey95", color = "grey60", linewidth = 0.2) +
