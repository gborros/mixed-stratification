## DUMMY SAMPLE SCRIPT
## Author: Georgi Borros
## Date 14 July 2026
#-------------------------------------------------------------------------------
# Libraries and Globals
library(sf)
library(readxl)
library(dplyr)
library(ggplot2)
library(purrr)
gispath <- "//researchdata2.uct.ac.za/SALDRU-SDH/Data_Department/HQ/HARPS/Wave 1/Sample/GIS"
censuspath <- "//researchdata2.uct.ac.za/SALDRU-SDH/Data_Department/HQ/HARPS/Wave 1/Sample/CENSUS2022"
ea_shapefile <- file.path(gispath, "EA", "ea_sf.rds")
sal_shapefile <- file.path(gispath, "SAL 2013", "sal_sf.rds")
district_shapefile <- file.path(gispath, "Districts", "dist_sf.rds")
municipality_shapefile <- file.path(gispath, "LocalMunicipality", "mun_sf.rds")
#-------------------------------------------------------------------------------
# Read in shapefile data
ea_sf <- readRDS(ea_shapefile)
#sal_sf <- readRDS(sal_shapefile)
mun_sf <- readRDS(municipality_shapefile)
dist_sf <- readRDS(district_shapefile)
cat("EA CRS:", st_crs(ea_sf)$input, "\n")
cat("Mun CRS:", st_crs(mun_sf)$input, "\n")
cat("Dist CRS:", st_crs(dist_sf)$input, "\n")
# ---- Use EA centroids for the spatial match ----
# (avoids an EA being matched to multiple polygons if it straddles a boundary)
ea_centroids <- st_centroid(ea_sf)
# ---- Spatial join: which municipality contains each EA centroid ----
ea_with_mun <- st_join(
ea_centroids,
mun_sf %>% select(MUNICNAME, DISTRICT_N, Total, Total_40plus),  # keep only relevant columns
join = st_within
)
ea_with_mun_dist <- st_join(
ea_with_mun,
dist_sf %>% select(DISTRICT_NAME = DISTRICT_N),
join = st_within
)
no_mun_match <- ea_with_mun %>% filter(is.na(MUNICNAME))
cat("EAs with no municipality match:", nrow(no_mun_match), "\n")
## 11 did not match
ea_final <- ea_sf %>%
st_drop_geometry() %>%
bind_cols(
ea_with_mun_dist %>% st_drop_geometry() %>% select(MUNICNAME, Total_40plus, DISTRICT_N, DISTRICT_NAME)
) %>%
st_sf(geometry = st_geometry(ea_sf))
#-------------------------------------------------------------------------------
# Randomly sample 150 EAs
# Set a seed so the sample is reproducible
set.seed(123)
n_total <- 150
n_total <- 150
min_per_stratum <- 2
district_sizes <- ea_final %>%
st_drop_geometry() %>%
filter(!is.na(DISTRICT_NAME)) %>%
count(DISTRICT_NAME, name = "n_eas") %>%
mutate(proportion = n_eas / sum(n_eas))
#-------------------------------------------------------------------------------
# Step 1: proportional allocation, then floor at min_per_stratum
district_sizes <- district_sizes %>%
mutate(
n_sample_raw = proportion * n_total,
n_sample = pmax(round(n_sample_raw), min_per_stratum)
)
# Step 2: check how much this floor has pushed the total over
cat("Total after flooring at", min_per_stratum, ":", sum(district_sizes$n_sample),
"(target:", n_total, ")\n")
### QUESTION - CAN WE SAMPLE ~166 EAs (must first check this number once 11 that don't matched are fixed)
# Join allocation onto the EA data
ea_joined <- ea_final %>%
left_join(district_sizes %>% select(DISTRICT_NAME, n_sample), by = "DISTRICT_NAME")
ea_joined <- ea_joined %>%
filter(!is.na(DISTRICT_NAME))
# Split into a list of sf objects, one per district
ea_split <- split(ea_joined, ea_joined$DISTRICT_NAME)
# Sample within each district explicitly, using each district's own n_sample value
ea_sample_list <- map(ea_split, function(df) {
n_this_district <- unique(df$n_sample)
if (length(n_this_district) != 1) {
stop("District has inconsistent n_sample values - check the join")
}
if (n_this_district == 0) return(df[0, ])  # empty sf with 0 rows, keeps structure
slice_sample(df, n = n_this_district, weight_by = Total_40plus)
})
# Recombine into a single sf object
ea_sample <- bind_rows(ea_sample_list)
class(ea_sample)          # confirm this is still "sf"
nrow(ea_sample)           # should be 150 (or 150 minus whatever the NA-district exclusion cost you)
ggplot() +
geom_sf(data = dist_sf, fill = "grey95", color = "grey60", linewidth = 0.2) +
geom_sf(data = ea_sample, fill = "steelblue", color = "black", size = 0.3) +
theme_minimal() +
labs(title = paste0("Stratified Sample of EAs by District (n = ", nrow(ea_sample), ")"))
