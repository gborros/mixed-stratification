)
ea_with_mun_dist <- st_join(
ea_with_mun,
dist_sf %>% select(DISTRICT_NAME = DISTRICT_N),
join = st_within
)
no_mun_match <- ea_with_mun %>% filter(is.na(MUNICNAME))
cat("EAs with no municipality match:", nrow(no_mun_match), "\n")
# Flag which EAs did not get a municipality match
ea_final <- ea_final %>%
mutate(matched = !is.na(MUNICNAME))
ea_final <- ea_sf %>%
st_drop_geometry() %>%
bind_cols(
ea_with_mun_dist %>% st_drop_geometry() %>% select(MUNICNAME, DISTRICT_N, DISTRICT_NAME)
) %>%
st_sf(geometry = st_geometry(ea_sf))
#-------------------------------------------------------------------------------
