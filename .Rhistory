# Randomly sample 150 EAs
# Set a seed so the sample is reproducible
set.seed(123)
n_total <- 150
n_total <- 150
min_per_stratum <- 2
district_sizes <- ea_final %>%
st_drop_geometry() %>%
filter(!is.na(DISTRICT_NAME)) %>%
count(DISTRICT_NAME, name = "n_eas") %>%
mutate(proportion = n_eas / sum(n_eas))
#-------------------------------------------------------------------------------
# Step 1: proportional allocation, then floor at min_per_stratum
district_sizes <- district_sizes %>%
mutate(
n_sample_raw = proportion * n_total,
n_sample_floored = pmax(round(n_sample_raw), min_per_stratum)
)
# Step 2: check how much this floor has pushed the total over
cat("Total after flooring at", min_per_stratum, ":", sum(district_sizes$n_sample_floored),
"(target:", n_total, ")\n")
# Step 3: proportionally trim the excess from strata that are ABOVE the floor
excess <- sum(district_sizes$n_sample_floored) - n_total
if (excess > 0) {
above_floor <- district_sizes %>% filter(n_sample_floored > min_per_stratum)
# Trim proportional to each stratum's share of the "above-floor" allocation
above_floor <- above_floor %>%
mutate(
trim_share = (n_sample_floored - min_per_stratum) / sum(n_sample_floored - min_per_stratum),
trim_amount = round(trim_share * excess)
)
district_sizes <- district_sizes %>%
left_join(above_floor %>% select(DISTRICT_NAME, trim_amount), by = "DISTRICT_NAME") %>%
mutate(
trim_amount = coalesce(trim_amount, 0),
n_sample = n_sample_floored - trim_amount
)
} else {
district_sizes <- district_sizes %>% mutate(n_sample = n_sample_floored)
}
cat("Final total:", sum(district_sizes$n_sample), "\n")
print(district_sizes %>% select(DISTRICT_NAME, n_eas, n_sample_raw, n_sample_floored, n_sample))
# Step 1: proportional allocation, then floor at min_per_stratum
district_sizes <- district_sizes %>%
mutate(
n_sample_raw = proportion * n_total,
n_sample = pmax(round(n_sample_raw), min_per_stratum)
)
# Step 2: check how much this floor has pushed the total over
cat("Total after flooring at", min_per_stratum, ":", sum(district_sizes$n_sample),
"(target:", n_total, ")\n")
### QUESTION - CAN WE SAMPLE ~166 EAs (must first check this number once 11 that don't matched are fixed)
