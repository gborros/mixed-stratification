set.seed(123)
n_total <- 150
# ---- Proportional allocation across districts ----
district_sizes <- ea_sf %>%
st_drop_geometry() %>%
count(DISTRICT_NAME, name = "n_eas")
View(ea_final)
set.seed(123)
n_total <- 150
# ---- Proportional allocation across districts ----
district_sizes <- ea_final %>%
st_drop_geometry() %>%
count(DISTRICT_NAME, name = "n_eas")
district_sizes <- district_sizes %>%
mutate(
proportion = n_eas / sum(n_eas),
n_sample_raw = proportion * n_total,
n_sample = round(n_sample_raw)
)
# Rounding won't always sum exactly to 150 - check and adjust if needed
cat("Sum of rounded allocations:", sum(district_sizes$n_sample), "(target:", n_total, ")\n")
diff <- n_total - sum(district_sizes$n_sample)
if (diff != 0) {
largest_district <- district_sizes$DISTRICT_NAME[which.max(district_sizes$n_eas)]
district_sizes <- district_sizes %>%
mutate(n_sample = if_else(DISTRICT_NAME == largest_district,
n_sample + diff, n_sample))
}
cat("Final sum after adjustment:", sum(district_sizes$n_sample), "\n")
print(district_sizes)
# ---- Draw the stratified sample ----
ea_sample <- ea_final %>%
left_join(district_sizes %>% select(DISTRICT_NAME, n_sample), by = "DISTRICT_NAME") %>%
group_by(DISTRICT_NAME) %>%
group_modify(~ slice_sample(.x, n = unique(.x$n_sample))) %>%
ungroup()
cat("Total EAs sampled:", nrow(ea_sample), "(target:", n_total, ")\n")
# ---- Plot the stratified sample ----
ggplot() +
geom_sf(data = mun_sf, fill = "grey95", color = "grey60", linewidth = 0.2) +
geom_sf(data = ea_sample, fill = "steelblue", color = "black", size = 0.3) +
theme_minimal() +
labs(title = paste0("Stratified Sample of EAs by District (n = ", nrow(ea_sample), ")"))
